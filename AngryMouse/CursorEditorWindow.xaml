<Window x:Class="AngryMouse.CursorEditorWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:local="clr-namespace:AngryMouse"
mc:Ignorable="d"
Title="Cursor Editor"
Icon="{x:Static local:AppIcon.ImageSource}"
Width="600"
Height="500"
MinWidth="480"
MinHeight="400"
ResizeMode="CanResizeWithGrip"
Closed="Window_Closed">
<Grid Margin="16" Background="{DynamicResource Theme.WindowBackgroundBrush}">
<Grid.RowDefinitions>
<RowDefinition Height="Auto" />
<RowDefinition Height="*" />
<RowDefinition Height="Auto" />
</Grid.RowDefinitions>

<TextBlock Grid.Row="0" Text="Cursor Hotspot Editor" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

<Grid Grid.Row="1">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="280" />
<ColumnDefinition Width="*" />
</Grid.ColumnDefinitions>

<!-- Left: Cursor preview -->
<Border Grid.Column="0"
Background="{DynamicResource Theme.PreviewCheckerBaseBrush}"
BorderBrush="{DynamicResource Theme.BorderBrush}"
BorderThickness="1"
Margin="0,0,16,0">
<Grid>
<!-- Checkerboard pattern -->
<Canvas Name="CursorCanvas" ClipToBounds="True" />
<!-- Hotspot crosshair -->
<Canvas Name="HotspotOverlay" IsHitTestVisible="False" />
</Grid>
</Border>

<!-- Right: Controls -->
<StackPanel Grid.Column="1" VerticalAlignment="Top">
<TextBlock Text="Hotspot Offset" FontWeight="SemiBold" Margin="0,0,0,8" />

<Grid Margin="0,0,0,12">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="40" />
<ColumnDefinition Width="*" />
<ColumnDefinition Width="50" />
</Grid.ColumnDefinitions>
<Grid.RowDefinitions>
<RowDefinition Height="Auto" />
<RowDefinition Height="Auto" />
</Grid.RowDefinitions>

<TextBlock Grid.Row="0" Grid.Column="0" Text="X:" VerticalAlignment="Center" />
<Slider Name="HotspotXSlider" Grid.Row="0" Grid.Column="1"
Minimum="-100" Maximum="100" TickFrequency="1"
IsSnapToTickEnabled="True"
ValueChanged="HotspotSlider_OnValueChanged" Margin="4,4,8,4" />
<TextBox Name="HotspotXTextBox" Grid.Row="0" Grid.Column="2"
Width="50" TextAlignment="Center"
VerticalContentAlignment="Center"
TextChanged="HotspotTextBox_OnTextChanged" />

<TextBlock Grid.Row="1" Grid.Column="0" Text="Y:" VerticalAlignment="Center" />
<Slider Name="HotspotYSlider" Grid.Row="1" Grid.Column="1"
Minimum="-100" Maximum="100" TickFrequency="1"
IsSnapToTickEnabled="True"
ValueChanged="HotspotSlider_OnValueChanged" Margin="4,4,8,4" />
<TextBox Name="HotspotYTextBox" Grid.Row="1" Grid.Column="2"
Width="50" TextAlignment="Center"
VerticalContentAlignment="Center"
TextChanged="HotspotTextBox_OnTextChanged" />
</Grid>

<Separator Margin="0,0,0,12" />

<TextBlock Text="Current Info" FontWeight="SemiBold" Margin="0,0,0,4" />
<TextBlock Name="InfoTextBlock" TextWrapping="Wrap"
Foreground="{DynamicResource Theme.SecondaryForegroundBrush}" />

<Button Content="_Reset to Default" Margin="0,16,0,0" Padding="8,4"
Click="ResetButton_OnClick" />
</StackPanel>
</Grid>

<WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,12,0,0">
<Button Content="A_pply" Width="80" Padding="8,4" Margin="0,0,8,0"
Click="ApplyButton_OnClick" />
<Button Content="_Cancel" Width="80" Padding="8,4"
Click="CancelButton_OnClick" />
</WrapPanel>
</Grid>
</Window>
